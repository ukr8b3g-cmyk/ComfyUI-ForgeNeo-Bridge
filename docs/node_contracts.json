      "class_id": "ForgeNeoBridgeKSampler",
      "display_name": "ForgeNeo Bridge KSampler",
      "required_inputs": {"model": "MODEL", "positive": "FORGE_TEXT_INPUT", "negative": "FORGE_TEXT_INPUT", "settings": "FORGE_SETTINGS", "seed": "STRING uint64", "steps": "INT", "cfg": "FLOAT", "sampler_name": "COMBO", "scheduler": "COMBO", "denoise": "FLOAT"},
